#!/usr/bin/env bash
# Minuteur Omarchy : un timer systemd utilisateur qui notifie, met en veille ou
# éteint à la fin. Il vit hors de la barre : un redémarrage du shell ne l'annule pas.
#
#   minuteur start <minutes|HH:MM> <notify|suspend|shutdown>
#   minuteur extend <minutes>        ajoute du temps au minuteur en cours
#   minuteur cancel [--quiet]
#   minuteur status                  état JSON ({} si aucun minuteur)
#   minuteur warn|fire <action>      appelés par le timer
set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-minuteur.json"
UNIT=omarchy-minuteur
SELF="$(readlink -f "$0")"

notify() { notify-send -a "Minuteur" "$@" 2>/dev/null || true; }
label() {
  case $1 in
    notify) echo "Fin du minuteur" ;;
    suspend) echo "Mise en veille" ;;
    shutdown) echo "Extinction" ;;
  esac
}
valid_action() { [[ ${1:-} =~ ^(notify|suspend|shutdown)$ ]]; }
active() { systemctl --user is-active --quiet "$UNIT.timer"; }

stop_units() {
  # Une par une : systemctl abandonne toute la liste dès qu'une unité n'existe pas.
  local n
  for n in "$UNIT.timer" "$UNIT-warn.timer" "$UNIT.service" "$UNIT-warn.service"; do
    systemctl --user stop "$n" 2>/dev/null || true
    systemctl --user reset-failed "$n" 2>/dev/null || true
  done
  # Un timer transitoire met un instant à disparaître : on attend avant d'en recréer un du même nom.
  local i u
  for i in $(seq 1 40); do
    u=0
    for n in "$UNIT.timer" "$UNIT-warn.timer"; do
      [[ $(systemctl --user show -p LoadState --value "$n" 2>/dev/null) == not-found ]] || u=1
    done
    (( u == 0 )) && return 0
    sleep 0.05
  done
}

schedule() { # end_epoch action start_epoch
  local end=$1 action=$2 start=$3 now
  now=$(date +%s)
  stop_units
  # L'environnement graphique, pour que notify-send et l'extinction propre d'Omarchy marchent.
  local env=()
  for v in PATH DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE DBUS_SESSION_BUS_ADDRESS; do
    [[ -n ${!v:-} ]] && env+=("--setenv=$v=${!v}")
  done
  local at; at=$(date -d "@$end" '+%Y-%m-%d %H:%M:%S')
  systemd-run --user --quiet --unit="$UNIT" --on-calendar="$at" \
    --timer-property=AccuracySec=1s --timer-property=RemainAfterElapse=no \
    "${env[@]}" "$SELF" fire "$action"
  if [[ $action != notify ]] && (( end - now > 75 )); then
    systemd-run --user --quiet --unit="$UNIT-warn" --on-calendar="$(date -d "@$((end - 60))" '+%Y-%m-%d %H:%M:%S')" \
      --timer-property=AccuracySec=1s --timer-property=RemainAfterElapse=no \
      "${env[@]}" "$SELF" warn "$action"
  fi
  mkdir -p "$(dirname "$STATE")"
  printf '{"start":%d,"end":%d,"action":"%s"}\n' "$start" "$end" "$action" > "$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
}

field() { sed -n "s/.*\"$1\":\"\{0,1\}\([a-z0-9]*\)\"\{0,1\}.*/\1/p" "$STATE" 2>/dev/null; }

case ${1:-} in
  start)
    when=${2:-}; action=${3:-notify}
    valid_action "$action" || { echo "action inconnue : $action" >&2; exit 2; }
    now=$(date +%s)
    if [[ $when =~ ^[0-9]{1,4}$ ]] && (( 10#$when >= 1 && 10#$when <= 1440 )); then
      end=$((now + 10#$when * 60))
    elif [[ $when =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then
      end=$(date -d "today $when" +%s)
      (( end > now + 5 )) || end=$(date -d "tomorrow $when" +%s)
    else
      echo "durée (1-1440 min) ou heure HH:MM attendue" >&2; exit 2
    fi
    schedule "$end" "$action" "$now"
    notify "Minuteur lancé" "$(label "$action") à $(date -d "@$end" +%H:%M)"
    ;;
  extend)
    add=${2:-5}
    [[ $add =~ ^[0-9]{1,3}$ ]] && (( 10#$add >= 1 )) || { echo "minutes attendues" >&2; exit 2; }
    active && [[ -f $STATE ]] || { echo "aucun minuteur" >&2; exit 1; }
    end=$(field end); start=$(field start); action=$(field action)
    valid_action "$action" || exit 1
    schedule "$((end + 10#$add * 60))" "$action" "$start"
    notify "Minuteur prolongé" "$(label "$action") à $(date -d "@$((end + 10#$add * 60))" +%H:%M)"
    ;;
  cancel)
    stop_units; rm -f "$STATE"
    [[ ${2:-} == --quiet ]] || notify "Minuteur annulé"
    ;;
  status)
    # Un timer disparu (déconnexion, redémarrage) ne laisse pas d'état fantôme.
    if [[ -f $STATE ]] && ! active; then rm -f "$STATE"; fi
    cat "$STATE" 2>/dev/null || echo '{}'
    ;;
  warn)
    valid_action "${2:-}" || exit 2
    notify -u critical "$(label "$2") dans 1 minute" "Annule ou prolonge depuis la barre ou le bureau."
    ;;
  fire)
    valid_action "${2:-}" || exit 2
    rm -f "$STATE"
    case $2 in
      notify) notify -u critical "Minuteur terminé" "C'est l'heure." ;;
      suspend) notify "Mise en veille…"; sleep 2; systemctl suspend ;;
      shutdown) exec omarchy-system shutdown ;;
    esac
    ;;
  *)
    sed -n '2,10p' "$SELF"; exit 2 ;;
esac
